{
  "name": "grocery-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "web": "expo start --web",
    "eas:update": "pnpm eas:update:production",
    "eas:build:dev:ios": "eas build --profile development --platform ios",
    "eas:build:dev:android": "eas build --profile development --platform android",
    "eas:build:preview": "eas build --profile preview --platform all",
    "eas:build:production": "eas build --profile production --platform all",
    "eas:update:development": "eas update --channel development --environment development",
    "eas:update:preview": "eas update --channel preview --environment preview",
    "eas:update:production": "eas update --channel production --environment production",
    "eas:submit:ios": "eas submit --platform ios --profile production",
    "eas:submit:android": "eas submit --platform android --profile production",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo 'No automated tests yet'",
    "format:paths": "prettier --write",
    "format:check:paths": "prettier --check"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "expo": "~58.0.25",
    "expo-auth-session": "^58.0.18",
    "expo-background-task": "~58.0.13",
    "expo-constants": "^58.0.16",
    "expo-dev-client": "^58.0.20",
    "expo-linking": "^58.0.17",
    "expo-router": "^58.0.31",
    "expo-secure-store": "^58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "^58.0.8",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-worklets": "0.13.0",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@react-native-async-storage/expo-with-async-storage": "^1.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.25",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "@expo/dom-webview"
      ]
    }
  },
  "private": true,
  "packageManager": "pnpm@10.18.3"
}
